using System;
using UnityEngine;
using UnityEngine.SceneManagement;

/// <summary>
/// Central manager for game goals. Call CompleteGoal when a goal is met.
/// Other systems can subscribe to OnGoalCompleted to react (UI, rewards, progression).
/// </summary>
public class GoalManager : MonoBehaviour
{
    public static GoalManager Instance { get; private set; }

    public event Action<string> OnGoalCompleted;

    [Tooltip("If true, the GoalManager object will persist across scenes")]
    [SerializeField] private bool dontDestroyOnLoad = false;

    // track completed goals in this runtime session
    private System.Collections.Generic.HashSet<string> completedGoals = new System.Collections.Generic.HashSet<string>();

    private void Awake()
    {
        if (Instance != null && Instance != this)
        {
            Destroy(gameObject);
            return;
        }

        Instance = this;
        if (dontDestroyOnLoad) DontDestroyOnLoad(gameObject);
    }

    /// <summary>
    /// Mark a goal as completed. id can be null/empty. description is optional for logging.
    /// If nextSceneIndex >= 0 the manager will load that scene. If endGame is true, GameManager.EndGame() is called.
    /// </summary>
    public void CompleteGoal(string id = "", string description = null, bool endGame = false, int nextSceneIndex = -1)
    {
        if (!string.IsNullOrEmpty(description))
            Debug.Log($"GoalManager: Goal completed '{id}' - {description}");
        else
            Debug.Log($"GoalManager: Goal completed '{id}'");

        // record completion
        if (!string.IsNullOrEmpty(id))
        {
            if (!completedGoals.Contains(id))
            {
                completedGoals.Add(id);
                // persist to save file
                SaveSystem.AddCompletedGoal(id);
            }
        }

        OnGoalCompleted?.Invoke(id);

        if (endGame && GameManager.Instance != null)
        {
            GameManager.Instance.EndGame();
        }

        if (nextSceneIndex >= 0)
        {
            SceneManager.LoadScene(nextSceneIndex);
        } 
    }

    /// <summary>
    /// Restore completed goals from save without invoking completion events.
    /// </summary>
    public void RestoreCompletedGoals(string[] ids)
    {
        if (ids == null) return;
        foreach (var id in ids)
        {
            if (string.IsNullOrEmpty(id)) continue;
            completedGoals.Add(id);
        }
    }

    public bool IsGoalCompleted(string id)
    {
        if (string.IsNullOrEmpty(id)) return false;
        return completedGoals.Contains(id);
    }
}