using UnityEngine;
using UnityEngine.SceneManagement;

public class PauseMenu : MonoBehaviour
{
    [SerializeField] private GameObject pauseMenuUI;


    private void Start()
    {
        bool isPaused = GameManager.Instance != null && GameManager.Instance.State == GameState.Paused;
        Debug.Log($"PauseMenu Start - GameManager present={GameManager.Instance != null}, initialPaused={isPaused}");
        if (pauseMenuUI != null) pauseMenuUI.SetActive(isPaused);

    }

    private void Update()
    {
        if (Input.GetKeyDown(KeyCode.Escape))
        {
            Debug.Log("PauseMenu: Escape pressed");
            TogglePause();
        }
    }

    public void TogglePause()
    {
        if (GameManager.Instance == null) return;
        Debug.Log($"PauseMenu.TogglePause - currentState={GameManager.Instance.State}");
        if (GameManager.Instance.State == GameState.Paused)
        {
            ContinueGame();
        }
        else if (GameManager.Instance.State == GameState.Playing)
        {
            PauseGame();
        }
    }

    public void PauseGame()
    {
        if (GameManager.Instance == null) return;
        Debug.Log("PauseMenu.PauseGame - pausing game");
        GameManager.Instance.PauseGame();
        if (pauseMenuUI != null) pauseMenuUI.SetActive(true);
    }

    public void ContinueGame()
    {
        if (GameManager.Instance == null) return;
        Debug.Log("PauseMenu.ContinueGame - resuming game");
        GameManager.Instance.ResumeGame();
        if (pauseMenuUI != null) pauseMenuUI.SetActive(false);
    }

    public void BackToMainMenu()
    {
        Debug.Log("PauseMenu.BackToMainMenu - returning to main menu");
        if (GameManager.Instance != null)
        {
            GameManager.Instance.ReturnToMainMenu();
            return;
        }

        SceneManager.LoadScene(0);
    }
    public void QuitGame()
    {
        Debug.Log("PauseMenu.QuitGame - quitting application");
        Application.Quit();
    }
}
