using System;
using UnityEngine;
using UnityEngine.UI;

public class PlayerInfoUI : MonoBehaviour
{
    [Header("UI Targets")]
    [Tooltip("Root panel to show/hide (assign the panel GameObject)")]
    [SerializeField] private GameObject panel;
    [Tooltip("A GameObject that has either a UnityEngine.UI.Text or a TextMeshPro TMP_Text component")]
    [SerializeField] private GameObject titleTarget;
    [SerializeField] private GameObject mechanicsTarget;
    [SerializeField] private GameObject goalTarget;

    [Header("Defaults")]
    [SerializeField] private string defaultTitle = "How to Play";
    [TextArea(3,6)] [SerializeField] private string defaultMechanics = "Move with WASD or arrow keys. Jump with Space. Interact with E. Use attacks to defeat enemies and progress through rooms.";
    [TextArea(2,4)] [SerializeField] private string defaultGoal = "Reach the throne, overcome challenges, and defeat the final boss.";

    [Header("Behavior")]
    [SerializeField] private bool pauseWhenOpen = true;

    private float previousTimeScale = 1f;

    void Awake()
    {
        if (panel != null)
            panel.SetActive(false);
    }

    // Show defaults
    public void ShowDefault()
    {
        ShowInfo(defaultMechanics, defaultGoal, defaultTitle);
    }

    // Show custom info
    public void ShowInfo(string mechanics, string goal, string title = null)
    {
        if (panel == null) return;

        var t = string.IsNullOrEmpty(title) ? defaultTitle : title;

        SetTextOnTarget(titleTarget, t);
        SetTextOnTarget(mechanicsTarget, mechanics);
        SetTextOnTarget(goalTarget, goal);

        panel.SetActive(true);
        if (pauseWhenOpen)
        {
            previousTimeScale = Time.timeScale;
            Time.timeScale = 0f;
        }
    }

    public void Hide()
    {
        if (panel == null) return;
        panel.SetActive(false);
        if (pauseWhenOpen) Time.timeScale = previousTimeScale;
    }

    public void Toggle()
    {
        if (panel == null) return;
        if (panel.activeSelf) Hide(); else ShowDefault();
    }

    // Try to set text on either UnityEngine.UI.Text or TextMeshPro.TMP_Text (reflection used for TMP to avoid hard dependency)
    private void SetTextOnTarget(GameObject target, string text)
    {
        if (target == null) return;

        // First try Unity UI Text
        var uiText = target.GetComponent<Text>();
        if (uiText != null)
        {
            uiText.text = text;
            return;
        }

        // Try TextMeshPro via reflection if available at runtime
        var tmpType = Type.GetType("TMPro.TMP_Text, Unity.TextMeshPro") ?? Type.GetType("TMPro.TMP_Text, Unity.TextMeshPro.Runtime") ;
        if (tmpType != null)
        {
            var tmpComp = target.GetComponent(tmpType);
            if (tmpComp != null)
            {
                var prop = tmpType.GetProperty("text");
                if (prop != null) prop.SetValue(tmpComp, text, null);
                return;
            }
        }

        // If neither component exists, try to find any component with a 'text' property and set it
        var comps = target.GetComponents<Component>();
        foreach (var c in comps)
        {
            var p = c.GetType().GetProperty("text");
            if (p != null && p.PropertyType == typeof(string))
            {
                p.SetValue(c, text, null);
                return;
            }
        }
    }
}
