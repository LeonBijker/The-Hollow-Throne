using System.Linq;
using UnityEngine;

/// <summary>
/// Listens to InputDeviceDetector and enables/disables Iinput implementations on the player.
/// Place in the scene (GameManager or any manager object). It will find the PlayerController and toggle components.
/// </summary>
public class InputSwitcher : MonoBehaviour
{
    [Tooltip("Optional: set to an existing PlayerController. If null, will FindObjectOfType<PlayerController>()")]
    [SerializeField] private PlayerController playerController;

    private void Start()
    {
        if (playerController == null)
            playerController = FindObjectOfType<PlayerController>();

        if (InputDeviceDetector.Instance != null)
        {
            InputDeviceDetector.Instance.OnInputDeviceChanged += OnDeviceChanged;
            // apply current device immediately
            ApplyDevice(InputDeviceDetector.Instance.CurrentDevice);
        }
    }

    private void OnDestroy()
    {
        if (InputDeviceDetector.Instance != null)
            InputDeviceDetector.Instance.OnInputDeviceChanged -= OnDeviceChanged;
    }

    private void OnDeviceChanged(InputDeviceType device)
    {
        ApplyDevice(device);
    }

    private void ApplyDevice(InputDeviceType device)
    {
        if (playerController == null) return;

        var go = playerController.gameObject;
        var inputs = go.GetComponents<MonoBehaviour>().Where(m => m is Iinput).ToArray();
        foreach (var comp in inputs)
        {
            // enable keyboard when KeyboardMouse, controller when Controller
            if (comp is KeyboardInput)
                comp.enabled = (device == InputDeviceType.KeyboardMouse);
            else if (comp is ControllerInput)
                comp.enabled = (device == InputDeviceType.Controller);
            else
                comp.enabled = (device == InputDeviceType.KeyboardMouse); // default to keyboard
        }
    }
}
